# ============================================
# Laravel x402 Package Configuration
# ============================================

# REQUIRED: Your wallet address to receive payments
X402_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Network Configuration
# Options: base-sepolia (testnet), base-mainnet, ethereum-sepolia, ethereum-mainnet
X402_DEFAULT_NETWORK=base-sepolia

# Protocol Version
X402_PROTOCOL_VERSION=1

# Facilitator Configuration
# The facilitator service handles payment verification and settlement
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_FACILITATOR_TIMEOUT=30

# Payment Defaults
X402_DEFAULT_SCHEME=exact
X402_DEFAULT_TIMEOUT=300
X402_DEFAULT_MIME_TYPE=application/json

# Asset Addresses (USDC by default)
# Base Sepolia (Testnet)
# X402_DEFAULT_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Base Mainnet
# X402_DEFAULT_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Logging Configuration
X402_LOGGING_ENABLED=true
X402_LOGGING_CHANNEL=stack

# Cache Configuration
# Caching reduces API calls to the facilitator
X402_CACHE_ENABLED=true
X402_CACHE_TTL=300

# Security Settings
X402_VERIFY_SSL=true
X402_MAX_PAYMENT_AGE=600
