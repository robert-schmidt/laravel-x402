{
    "name": "robert-schmidt/laravel-x402",
    "description": "Laravel package for the x402 payment protocol - enabling blockchain-based HTTP payments",
    "type": "library",
    "keywords": ["laravel", "x402", "payment", "blockchain", "coinbase", "usdc", "crypto", "web3"],
    "license": "MIT",
    "authors": [
        {
            "name": "Robert Schmidt",
            "homepage": "https://robertschmidt.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^9.0|^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "X402\\LaravelX402\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "X402\\LaravelX402\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "X402\\LaravelX402\\X402ServiceProvider"
            ],
            "aliases": {
                "X402": "X402\\LaravelX402\\Facades\\X402"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse src tests --level=5",
        "format": "vendor/bin/php-cs-fixer fix",
        "format-check": "vendor/bin/php-cs-fixer fix --dry-run --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
